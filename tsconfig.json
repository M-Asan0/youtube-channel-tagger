{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "jsx": "react-jsx",

    "sourceMap": true,
    "skipLibCheck": true,

    "types": ["chrome"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}